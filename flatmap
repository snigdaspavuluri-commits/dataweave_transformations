%dw 2.0
import * from dw::core::Arrays
output application/json  
---
payload.regions flatMap ((region) -> region.stores flatMap ((store) -> store.employees filter ((employee) -> not isEmpty(employee.skills)) flatMap ((employee) -> employee.skills map ((empSkill) -> {
        employeeId: employee.id,
        employeeName: employee.name,
        skill: empSkill,
        storeId: store.storeId,
        region: region.regionName
      }))))

